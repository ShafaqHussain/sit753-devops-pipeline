.git
.gitignore
.claude

# Frontend
frontend/node_modules
frontend/dist
frontend/.env

# Backend
backend/venv
backend/.venv
backend/__pycache__
backend/**/__pycache__
backend/**/*.py[cod]
backend/.pytest_cache
backend/instance
backend/static
backend/.env
backend/*.db
backend/tests
backend/requirements-dev.txt
backend/pytest.ini
backend/.coveragerc

# Pipeline artifacts. These need **/ rather than a bare name: a bare pattern
# anchors to the context root, so "htmlcov" would miss backend/htmlcov and the
# coverage reports would end up inside the production image.
**/coverage.xml
**/.coverage
**/htmlcov
**/reports
**/.pytest_cache
**/bandit-report.json
**/trivy-report.json
**/snyk-report.json
Jenkinsfile
monitoring
*.md
