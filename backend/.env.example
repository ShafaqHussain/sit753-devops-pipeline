# Flask
FLASK_SECRET_KEY=change-me-to-a-random-secret
JWT_SECRET_KEY=change-me-to-a-different-random-secret
JWT_EXP_DAYS=7

# Database
DATABASE_URL=sqlite:///chat.db

# CORS / Socket.IO — comma-separated if running more than one frontend dev
# server (e.g. different ports) against this backend at once.
FRONTEND_ORIGIN=http://localhost:5173

# Server
PORT=5000
